<Window x:Class="RGBSelcer.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        Title="RGB SELCER — Выбор цвета" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F5F5">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="RGB SELCER" Style="{StaticResource HeaderStyle}"
                   Foreground="#FF4A90D9" FontSize="28"/>

        <!-- Название цвета -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Название цвета" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBox}" FontSize="16"/>
        </StackPanel>

        <!-- Слайдеры RGB -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <!-- Red -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="R" FontSize="16" FontWeight="Bold"
                       Foreground="Red" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                    Value="{Binding RedSlider}" Margin="10,5"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Red}"
                       FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <!-- Green -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="G" FontSize="16" FontWeight="Bold"
                       Foreground="Green" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                    Value="{Binding GreenSlider}" Margin="10,5"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}"
                       FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <!-- Blue -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="B" FontSize="16" FontWeight="Bold"
                       Foreground="Blue" VerticalAlignment="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                    Value="{Binding BlueSlider}" Margin="10,5"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}"
                       FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <!-- HEX код -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text="HEX: " FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding HexCode}" FontSize="18" FontWeight="Bold"
                       Foreground="#FF333333" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Предпросмотр цвета -->
        <Border Grid.Row="4" Height="80" CornerRadius="8" Margin="0,10"
                BorderBrush="#FF999999" BorderThickness="1"
                x:Name="ColorPreviewBorder">
            <Border.Background>
                <SolidColorBrush x:Name="PreviewBrush" Color="Gray"/>
            </Border.Background>
            <TextBlock Text="{Binding HexCode}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="20" FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Подтвердить" Style="{StaticResource SuccessButton}"
                    Click="ConfirmButton_Click" Padding="30,10" FontSize="16"/>
            <Button Content="Отмена" Style="{StaticResource DangerButton}"
                    Click="CancelButton_Click" Padding="30,10" FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>

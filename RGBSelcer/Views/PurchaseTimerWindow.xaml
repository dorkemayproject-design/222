<Window x:Class="RGBSelcer.Views.PurchaseTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SELCER ROYALITY PRM — Оформление покупки" Height="550" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFF5F0FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6C2BD9" Offset="0"/>
                    <GradientStop Color="#FF9B30FF" Offset="0.5"/>
                    <GradientStop Color="#FF7B2FEF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Списание средств" FontSize="20" FontWeight="Black"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="30,20" HorizontalAlignment="Center">
            <!-- Car Info -->
            <Border CornerRadius="12" Padding="18" Margin="0,0,0,20" Background="White"
                    HorizontalAlignment="Center" MinWidth="350">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="CarNameText" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="CarPriceText" FontSize="24" FontWeight="Black"
                               Foreground="#FF6C2BD9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Circular Timer -->
            <Grid Width="220" Height="220" Margin="0,0,0,20" HorizontalAlignment="Center">
                <!-- Background circle -->
                <Ellipse Width="220" Height="220" Stroke="#FFE0E0E0" StrokeThickness="8" Fill="White">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="15" Opacity="0.12"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Progress arc (drawn in code-behind) -->
                <Canvas x:Name="TimerCanvas" Width="220" Height="220"/>

                <!-- Inner decorative circle -->
                <Ellipse Width="180" Height="180" Fill="#FFF8F5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Timer text -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="03:00" FontSize="42" FontWeight="Black"
                               Foreground="#FF6C2BD9" HorizontalAlignment="Center"
                               FontFamily="Consolas"/>
                    <TextBlock x:Name="TimerLabel" Text="Списание средств..." FontSize="12"
                               Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Clock ticks -->
                <Canvas x:Name="TickCanvas" Width="220" Height="220"/>
            </Grid>

            <!-- Status -->
            <TextBlock x:Name="StatusText" Text="Обработка платежа..."
                       FontSize="14" Foreground="#FF555555" HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>

            <!-- Progress bar backup -->
            <ProgressBar x:Name="TimerProgress" Minimum="0" Maximum="180"
                         Height="6" Margin="20,12,20,0" Foreground="#FF6C2BD9"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="RGBSelcer.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:helpers="clr-namespace:RGBSelcer.Helpers"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        Title="SELCER ROYALITY PRM — Регистрация" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#33FFFFFF" CornerRadius="12"
                                BorderBrush="#55FFFFFF" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="#33FFFFFF" CornerRadius="12"
                                BorderBrush="#55FFFFFF" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernRegisterButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF1B5E20"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFDFFFDF" Offset="0"/>
                                    <GradientStop Color="#FFB8FFD0" Offset="0.5"/>
                                    <GradientStop Color="#FFD5FFE8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#6600FF88" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#CC69FF69" ShadowDepth="0" BlurRadius="25" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.04" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.04" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.95" Duration="0:0:0.06" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.95" Duration="0:0:0.06" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFBB86FC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF7B2FEF" Offset="0"/>
                <GradientStop Color="#FFB44AFF" Offset="0.35"/>
                <GradientStop Color="#FF9B30FF" Offset="0.65"/>
                <GradientStop Color="#FF6C2BD9" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.4" Color="#FF3D0066"/>
        </Border.Effect>

        <Grid>
            <Button Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,15,20,0" Click="CloseButton_Click"
                    FontSize="18" Foreground="#AAFFFFFF" Cursor="Hand"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="X" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" FontSize="18"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="X" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Ellipse Width="100" Height="100" Opacity="0.07" Fill="White"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-15,-20,0"/>
            <Ellipse Width="70" Height="70" Opacity="0.06" Fill="White"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-15,0,0,-10"/>

            <StackPanel VerticalAlignment="Center" Margin="50,25">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <helpers:Car3DModel Width="60" Height="60" Margin="0,0,12,0" ClipToBounds="True"
                                        CarType="suv" CarColor="#FF3060FF"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SELCER ROYALITY" FontSize="30" FontWeight="Black"
                                   Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF3D0066" ShadowDepth="3" BlurRadius="10" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="PRM" FontSize="20" FontWeight="Bold"
                                   Foreground="#FFEBB0FF" Margin="0,-5,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Создайте свой аккаунт" FontSize="14"
                           Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,20"
                           FontStyle="Italic"/>

                <Border CornerRadius="16" Padding="30,22">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.12"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="White" Opacity="0.25"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1.5</Border.BorderThickness>

                    <StackPanel>
                        <TextBlock Text="Регистрация" FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <TextBlock Text="ЛОГИН" FontSize="11" FontWeight="Bold" Foreground="#BBFFFFFF"
                                   Margin="5,0,0,3"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="#BBFFFFFF"
                                   Margin="5,10,0,3"/>
                        <PasswordBox helpers:PasswordHelper.BindPassword="True"
                                     helpers:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernPasswordBox}"/>

                        <TextBlock Text="ПОДТВЕРДИТЕ ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="#BBFFFFFF"
                                   Margin="5,10,0,3"/>
                        <PasswordBox helpers:PasswordHelper.BindPassword="True"
                                     helpers:PasswordHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernPasswordBox}"/>

                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FFFF6B6B"
                                   Margin="0,8" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>

                        <TextBlock Text="{Binding SuccessMessage}" FontSize="12" Foreground="#FF69FF69"
                                   Margin="0,5" TextWrapping="Wrap"
                                   Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVis}}"/>

                        <Button Content="СОЗДАТЬ АККАУНТ" Style="{StaticResource ModernRegisterButton}"
                                Margin="0,15,0,0" HorizontalAlignment="Stretch"
                                Click="RegisterButton_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <TextBlock Text="Уже есть аккаунт? " FontSize="14" Foreground="#99FFFFFF"
                                       VerticalAlignment="Center"/>
                            <Button Content="Войти" Style="{StaticResource ModernLinkButton}"
                                    Click="LoginLink_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="&#x00A9; 2025 SELCER ROYALITY PRM" FontSize="10"
                           Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="RGBSelcer.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:helpers="clr-namespace:RGBSelcer.Helpers"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        Title="RGB SELCER — Вход" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#33FFFFFF" CornerRadius="12"
                                BorderBrush="#55FFFFFF" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="#33FFFFFF" CornerRadius="12"
                                BorderBrush="#55FFFFFF" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernLoginButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF6C2BD9"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="#FFE8D5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#AA00FFFF" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#CCBB86FC" ShadowDepth="0" BlurRadius="25" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFE0C8FF" Offset="0"/>
                                            <GradientStop Color="#FFD0B0FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.04" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.04" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.95" Duration="0:0:0.06" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.95" Duration="0:0:0.06" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFBB86FC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6C2BD9" Offset="0"/>
                <GradientStop Color="#FF9B30FF" Offset="0.3"/>
                <GradientStop Color="#FFB44AFF" Offset="0.6"/>
                <GradientStop Color="#FF7B2FEF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.4" Color="#FF3D0066"/>
        </Border.Effect>

        <Grid>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,15,20,0" Click="CloseButton_Click"
                    FontSize="18" Foreground="#AAFFFFFF" Cursor="Hand"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="X" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" FontSize="18"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="X" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Ellipse Width="120" Height="120" Opacity="0.08" Fill="White"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-30,-20,0,0"/>
            <Ellipse Width="80" Height="80" Opacity="0.06" Fill="White"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,-10"/>
            <Ellipse Width="50" Height="50" Opacity="0.07" Fill="White"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,40,0"/>

            <StackPanel VerticalAlignment="Center" Margin="50,30">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <helpers:RgbCube3D Width="55" Height="55" Margin="0,0,12,0" ClipToBounds="True"/>
                    <TextBlock Text="RGB SELCER" FontSize="42" FontWeight="Black"
                               Foreground="White" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF3D0066" ShadowDepth="3" BlurRadius="10" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="Менеджер цветовых палитр" FontSize="14"
                           Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,25"
                           FontStyle="Italic"/>

                <Border CornerRadius="16" Padding="30,25">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.12"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="White" Opacity="0.25"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1.5</Border.BorderThickness>

                    <StackPanel>
                        <TextBlock Text="Вход в систему" FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="ЛОГИН" FontSize="11" FontWeight="Bold" Foreground="#BBFFFFFF"
                                   Margin="5,0,0,3"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="#BBFFFFFF"
                                   Margin="5,12,0,3"/>
                        <PasswordBox helpers:PasswordHelper.BindPassword="True"
                                     helpers:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernPasswordBox}"/>

                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FFFF6B6B"
                                   Margin="0,8" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>

                        <TextBlock Text="{Binding SuccessMessage}" FontSize="12" Foreground="#FF69FF69"
                                   Margin="0,5" TextWrapping="Wrap"
                                   Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVis}}"/>

                        <Button Content="ВОЙТИ" Style="{StaticResource ModernLoginButton}"
                                Margin="0,18,0,0" HorizontalAlignment="Stretch"
                                Click="LoginButton_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <TextBlock Text="Нет аккаунта? " FontSize="14" Foreground="#99FFFFFF"
                                       VerticalAlignment="Center"/>
                            <Button Content="Зарегистрироваться" Style="{StaticResource ModernLinkButton}"
                                    Click="RegisterLink_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2025 RGB SELCER • Учебный проект" FontSize="10"
                           Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

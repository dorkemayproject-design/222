<Window x:Class="RGBSelcer.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:helpers="clr-namespace:RGBSelcer.Helpers"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        Title="RGB SELCER — Вход" Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F5F5">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <Grid>
        <Border Background="White" CornerRadius="10" Margin="30"
                Padding="30" BorderBrush="#FFDDDDDD" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RGB SELCER" Style="{StaticResource HeaderStyle}"
                           Foreground="#FF4A90D9" FontSize="36"/>

                <TextBlock Text="Вход в систему" Style="{StaticResource SubHeaderStyle}"
                           HorizontalAlignment="Center" Foreground="#FF666666"/>

                <Separator Margin="0,15"/>

                <TextBlock Text="Логин" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"/>

                <TextBlock Text="Пароль" Style="{StaticResource FormLabel}"/>
                <PasswordBox helpers:PasswordHelper.BindPassword="True"
                             helpers:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputPasswordBox}"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>

                <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" FontSize="12"
                           Margin="0,5" TextWrapping="Wrap"
                           Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVis}}"/>

                <Button Content="Войти" Style="{StaticResource PrimaryButton}"
                        Margin="0,15,0,5" HorizontalAlignment="Stretch"
                        Click="LoginButton_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <TextBlock Text="Нет аккаунта? " FontSize="13" Foreground="#FF888888"/>
                    <Button Content="Зарегистрироваться" Style="{StaticResource LinkButton}"
                            Click="RegisterLink_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

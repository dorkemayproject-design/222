<Window x:Class="RGBSelcer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        Title="RGB SELCER — Главная" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:HexToColorBrushConverter x:Key="HexToBrush"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#FF4A90D9" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RGB SELCER" FontSize="24" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Палитры цветов" FontSize="16"
                               Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="5,0,0,3"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding UserName}" Foreground="White"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Профиль" Style="{StaticResource PrimaryButton}"
                            Background="#FF3A7BC8" Click="ProfileButton_Click" Padding="15,8"/>
                    <Button Content="Выйти" Style="{StaticResource DangerButton}"
                            Click="LogoutButton_Click" Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель — действия -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    Padding="15" Margin="0,0,10,0"
                    BorderBrush="#FFDDDDDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Действия" Style="{StaticResource SubHeaderStyle}"/>
                    <Separator Margin="0,5,0,10"/>

                    <Button Content="Создать палитру" Style="{StaticResource SuccessButton}"
                            Command="{Binding CreatePaletteCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Button Content="Открыть палитру" Style="{StaticResource PrimaryButton}"
                            Click="OpenPaletteButton_Click"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Button Content="Удалить палитру" Style="{StaticResource DangerButton}"
                            Command="{Binding DeletePaletteCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Separator Margin="0,15,0,10"/>

                    <TextBlock Text="Экспорт" Style="{StaticResource SubHeaderStyle}" FontSize="16"/>

                    <Button Content="Экспорт в JSON" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportJsonCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Button Content="Экспорт в CSV" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportCsvCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Button Content="Экспорт в TXT" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportTxtCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Separator Margin="0,15,0,10"/>

                    <TextBlock Text="Импорт" Style="{StaticResource SubHeaderStyle}" FontSize="16"/>

                    <Button Content="Импорт из JSON" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ImportJsonCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Button Content="Импорт из CSV" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ImportCsvCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>

                    <Separator Margin="0,15,0,10"/>

                    <TextBlock Text="Файлы" Style="{StaticResource SubHeaderStyle}" FontSize="16"/>

                    <Button Content="Удалить файл" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteFileCommand}"
                            HorizontalAlignment="Stretch" Margin="0,3"/>
                </StackPanel>
            </Border>

            <!-- Правая панель — список палитр -->
            <Border Grid.Column="1" Background="White" CornerRadius="8"
                    Padding="15" BorderBrush="#FFDDDDDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Мои палитры" Style="{StaticResource SubHeaderStyle}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Palettes}"
                              SelectedItem="{Binding SelectedPalette}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="1"
                              BorderBrush="#FFDDDDDD"
                              Margin="0,10,0,0"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Цветов" Binding="{Binding Colors.Count}" Width="80"/>
                            <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Обновлена" Binding="{Binding UpdatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель — статус и прогресс -->
        <Border Grid.Row="2" Background="White" Padding="10,8"
                BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="12" Foreground="#FF666666" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100"
                                 Width="200" Height="18" Margin="0,0,10,0"
                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0}%}"
                               Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                               VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"
                           VerticalAlignment="Center" Margin="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>

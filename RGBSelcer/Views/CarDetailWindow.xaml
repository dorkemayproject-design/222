<Window x:Class="RGBSelcer.Views.CarDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        xmlns:helpers="clr-namespace:RGBSelcer.Helpers"
        Title="SELCER ROYALITY PRM — Детали" Height="750" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF"
        BorderBrush="#FF6C2BD9" BorderThickness="2"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:CarDetailViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PriceFormatter x:Key="PriceFmt"/>
        <converters:BodyTypeToCarTypeConverter x:Key="BodyToCarType"/>
        <converters:StringToMediaColorConverter x:Key="StrToMediaColor"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6C2BD9" Offset="0"/>
                    <GradientStop Color="#FF9B30FF" Offset="0.5"/>
                    <GradientStop Color="#FF7B2FEF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SELCER ROYALITY PRM" FontSize="22" FontWeight="Black"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Карточка автомобиля" FontSize="14"
                               Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Назад" Click="BackButton_Click"
                        FontSize="13" FontWeight="SemiBold" Foreground="White"
                        Padding="16,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="8" Background="#44FFFFFF"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="25,20" DataContext="{Binding Car}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: 3D Model -->
                <StackPanel Grid.Column="0">
                    <Border CornerRadius="16" Height="320" ClipToBounds="True"
                            Margin="0,0,20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFE8E0F0" Offset="0"/>
                                <GradientStop Color="#FFF0EAFF" Offset="0.5"/>
                                <GradientStop Color="#FFF5F0FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3" BlurRadius="15" Opacity="0.15"/>
                        </Border.Effect>
                        <helpers:Car3DModel
                            CarType="{Binding BodyType, Converter={StaticResource BodyToCarType}}"
                            CarColor="{Binding Color, Converter={StaticResource StrToMediaColor}}"
                            ClipToBounds="True"/>
                    </Border>

                    <!-- Price + Buy -->
                    <Border CornerRadius="12" Padding="20,15" Margin="0,15,20,0"
                            Background="White">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Цена" FontSize="13" Foreground="#FF888888"/>
                            <TextBlock Text="{Binding Price, Converter={StaticResource PriceFmt}}"
                                       FontSize="32" FontWeight="Black" Foreground="#FF6C2BD9"
                                       Margin="0,3,0,10"/>
                            <Button Content="КУПИТЬ" Click="BuyButton_Click"
                                    FontSize="16" FontWeight="Bold" Foreground="White"
                                    Padding="20,12" Cursor="Hand"
                                    HorizontalAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF6C2BD9" Offset="0"/>
                                                    <GradientStop Color="#FF9B30FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#AA6C2BD9" ShadowDepth="0" BlurRadius="12" Opacity="0.4"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#CC9B30FF" ShadowDepth="0" BlurRadius="25" Opacity="0.7"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Specs -->
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="28" FontWeight="Black" Margin="0,0,0,3">
                        <Run Text="{Binding Brand, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Model, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="15" Foreground="#FF888888" Margin="0,0,0,15">
                        <Run Text="{Binding Year, Mode=OneWay}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding Country, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- License Badge -->
                    <WrapPanel Margin="0,0,0,15">
                        <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,5"
                                Background="#FFEDE7F6">
                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="#FF6C2BD9"
                                       Text="{Binding LicenseCategory, StringFormat=Категория прав: {0}}"/>
                        </Border>
                        <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,5"
                                Background="#FFE3F2FD">
                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="#FF1976D2"
                                       Text="{Binding BodyType}"/>
                        </Border>
                        <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,5"
                                Background="#FFFFF3E0">
                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="#FFF57C00"
                                       Text="{Binding FuelType}"/>
                        </Border>
                    </WrapPanel>

                    <!-- Description -->
                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#FF555555"
                               TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="20"/>

                    <!-- Technical Specs Grid -->
                    <Border CornerRadius="12" Background="White" Padding="18" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Технические характеристики" FontSize="16"
                                       FontWeight="Bold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" FontSize="13">
                                    <Run Text="Мощность: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding HorsePower, Mode=OneWay}"/>
                                    <Run Text=" л.с."/>
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontSize="13">
                                    <Run Text="Макс. скорость: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding MaxSpeedKmh, Mode=OneWay}"/>
                                    <Run Text=" км/ч"/>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" FontSize="13">
                                    <Run Text="Двигатель: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding EngineType, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontSize="13">
                                    <Run Text="Объём: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding EngineVolume, Mode=OneWay}"/>
                                    <Run Text=" л"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" FontSize="13">
                                    <Run Text="Разгон 0-100: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Acceleration0to100, Mode=OneWay}"/>
                                    <Run Text=" сек"/>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontSize="13">
                                    <Run Text="КПП: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Transmission, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" FontSize="13">
                                    <Run Text="Топливо: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding FuelType, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontSize="13">
                                    <Run Text="Расход: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding FuelConsumption, Mode=OneWay}"/>
                                    <Run Text=" л/100км"/>
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" FontSize="13">
                                    <Run Text="Привод: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding DriveType, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" FontSize="13">
                                    <Run Text="Масса: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Weight, Mode=OneWay}"/>
                                    <Run Text=" кг"/>
                                </TextBlock>

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" FontSize="13">
                                    <Run Text="Мест: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Seats, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4" FontSize="13">
                                    <Run Text="Цвет: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Color, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4" FontSize="13">
                                    <Run Text="Кузов: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BodyType, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4" FontSize="13">
                                    <Run Text="Страна: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Country, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4" FontSize="13">
                                    <Run Text="Категория прав: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding CategoryDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

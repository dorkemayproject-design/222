<Window x:Class="RGBSelcer.Views.PaletteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        Title="RGB SELCER — Редактор палитры" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:HexToColorBrushConverter x:Key="HexToBrush"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FF4A90D9" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
            <TextBlock Text="RGB SELCER — Редактор палитры" FontSize="20"
                       FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Информация о палитре -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10"
                BorderBrush="#FFDDDDDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Название палитры" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding PaletteName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Описание" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding PaletteDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Сохранить" Style="{StaticResource SuccessButton}"
                        Command="{Binding SavePaletteCommand}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
            </Grid>
        </Border>

        <!-- Список цветов -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15"
                BorderBrush="#FFDDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Цвета палитры" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                    <Button Content="Добавить цвет" Style="{StaticResource SuccessButton}"
                            Click="AddColorButton_Click" Margin="15,0,0,0" Padding="15,8"/>
                    <Button Content="Редактировать" Style="{StaticResource PrimaryButton}"
                            Click="EditColorButton_Click" Padding="15,8"/>
                    <Button Content="Удалить цвет" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteColorCommand}" Padding="15,8"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Colors}"
                          SelectedItem="{Binding SelectedColor}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          BorderBrush="#FFDDDDDD">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Цвет" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="40" Height="25" CornerRadius="3"
                                            Background="{Binding HexCode, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="#FF999999" BorderThickness="1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="R" Binding="{Binding Red}" Width="50"/>
                        <DataGridTextColumn Header="G" Binding="{Binding Green}" Width="50"/>
                        <DataGridTextColumn Header="B" Binding="{Binding Blue}" Width="50"/>
                        <DataGridTextColumn Header="HEX" Binding="{Binding HexCode}" Width="100"/>
                        <DataGridTextColumn Header="Порядок" Binding="{Binding SortOrder}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Статус -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" FontSize="12"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVis}}"/>
        </StackPanel>
    </Grid>
</Window>

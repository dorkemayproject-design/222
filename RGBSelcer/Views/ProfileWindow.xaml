<Window x:Class="RGBSelcer.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RGBSelcer.ViewModels"
        xmlns:helpers="clr-namespace:RGBSelcer.Helpers"
        xmlns:converters="clr-namespace:RGBSelcer.Converters"
        Title="SELCER ROYALITY PRM — Профиль" Height="650" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF">

    <Window.DataContext>
        <vm:ProfileViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6C2BD9" Offset="0"/>
                    <GradientStop Color="#FF9B30FF" Offset="0.5"/>
                    <GradientStop Color="#FF7B2FEF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SELCER ROYALITY PRM" FontSize="22" FontWeight="Black"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Личный кабинет" FontSize="14"
                               Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Закрыть" Click="CloseButton_Click"
                        FontSize="13" FontWeight="SemiBold" Foreground="White"
                        Padding="16,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="8" Background="#44FFFFFF"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,20">
                <!-- User Info -->
                <Border CornerRadius="12" Background="White" Padding="22" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Информация о пользователе" FontSize="18"
                                       FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock FontSize="14" Margin="0,3">
                                <Run Text="Логин: " FontWeight="SemiBold"/>
                                <Run Text="{Binding Login}"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Margin="0,3">
                                <Run Text="Дата регистрации: " FontWeight="SemiBold"/>
                                <Run Text="{Binding RegisteredAt}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border CornerRadius="8" Padding="15,10" Background="#FFEDE7F6" Margin="0,0,0,5">
                                <TextBlock FontSize="13" Foreground="#FF6C2BD9" FontWeight="Bold"
                                           TextAlignment="Center">
                                    <Run Text="Покупок: "/>
                                    <Run Text="{Binding PurchaseCount}"/>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="8" Padding="15,10" Background="#FFE8F5E9">
                                <TextBlock FontSize="13" Foreground="#FF388E3C" FontWeight="Bold"
                                           TextAlignment="Center">
                                    <Run Text="Потрачено: "/>
                                    <Run Text="{Binding TotalSpent}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Change Password -->
                <Border CornerRadius="12" Background="White" Padding="22" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Сменить пароль" FontSize="18"
                                   FontWeight="Bold" Margin="0,0,0,12"/>

                        <TextBlock Text="Текущий пароль:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <PasswordBox helpers:PasswordHelper.BindPassword="True"
                                     helpers:PasswordHelper.BoundPassword="{Binding OldPassword, Mode=TwoWay}"
                                     FontSize="14" Padding="10,8" Margin="0,0,0,10" MaxWidth="350"
                                     HorizontalAlignment="Left"/>

                        <TextBlock Text="Новый пароль:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <PasswordBox helpers:PasswordHelper.BindPassword="True"
                                     helpers:PasswordHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay}"
                                     FontSize="14" Padding="10,8" Margin="0,0,0,12" MaxWidth="350"
                                     HorizontalAlignment="Left"/>

                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FFD32F2F"
                                   FontWeight="SemiBold" Margin="0,0,0,5"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>
                        <TextBlock Text="{Binding SuccessMessage}" FontSize="12" Foreground="#FF388E3C"
                                   FontWeight="SemiBold" Margin="0,0,0,5"
                                   Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVis}}"/>

                        <Button Content="Сменить пароль" Command="{Binding ChangePasswordCommand}"
                                FontSize="14" FontWeight="SemiBold" Foreground="White"
                                Padding="20,10" Cursor="Hand" HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF6C2BD9" Offset="0"/>
                                                <GradientStop Color="#FF9B30FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#CC9B30FF" ShadowDepth="0"
                                                                      BlurRadius="15" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Purchase History -->
                <Border CornerRadius="12" Background="White" Padding="22">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="История покупок" FontSize="18"
                                   FontWeight="Bold" Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding Purchases}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="#FFDDDDDD"
                                  MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Автомобиль" Binding="{Binding Car.DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding PaidAmount, StringFormat={}{0:N0} ₽}" Width="150"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DateFormatted}" Width="150"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

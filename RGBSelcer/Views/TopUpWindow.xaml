<Window x:Class="RGBSelcer.Views.TopUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SELCER ROYALITY PRM — Пополнение баланса" Height="520" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFF5F0FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6C2BD9" Offset="0"/>
                    <GradientStop Color="#FF9B30FF" Offset="0.5"/>
                    <GradientStop Color="#FF7B2FEF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Пополнение баланса" FontSize="20" FontWeight="Black"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="30,25">
            <!-- Current Balance -->
            <Border CornerRadius="12" Padding="18" Margin="0,0,0,20" Background="White">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Текущий баланс" FontSize="13" Foreground="#FF888888"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BalanceText" FontSize="28" FontWeight="Black"
                               Foreground="#FF6C2BD9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card Info -->
            <Border CornerRadius="12" Padding="22" Background="White">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Данные карты Visa" FontSize="16" FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Номер карты:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="CardNumberBox" FontSize="15" Padding="12,10"
                             MaxLength="19" Margin="0,0,0,12"
                             TextChanged="CardNumber_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Срок (ММ/ГГ):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="ExpiryBox" FontSize="15" Padding="12,10" MaxLength="5">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CVV:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="CvvBox" FontSize="15" Padding="12,10" MaxLength="3"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Сумма пополнения (₽):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="AmountBox" FontSize="15" Padding="12,10" Margin="0,0,0,5">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Quick amounts -->
                    <WrapPanel Margin="0,8,0,15" HorizontalAlignment="Center">
                        <Button Content="50 000 ₽" Tag="50000" Click="QuickAmount_Click"
                                Padding="10,6" Margin="3" FontSize="11" Cursor="Hand"
                                Background="#FFEDE7F6" Foreground="#FF6C2BD9" FontWeight="Bold" BorderThickness="0"/>
                        <Button Content="100 000 ₽" Tag="100000" Click="QuickAmount_Click"
                                Padding="10,6" Margin="3" FontSize="11" Cursor="Hand"
                                Background="#FFEDE7F6" Foreground="#FF6C2BD9" FontWeight="Bold" BorderThickness="0"/>
                        <Button Content="500 000 ₽" Tag="500000" Click="QuickAmount_Click"
                                Padding="10,6" Margin="3" FontSize="11" Cursor="Hand"
                                Background="#FFEDE7F6" Foreground="#FF6C2BD9" FontWeight="Bold" BorderThickness="0"/>
                        <Button Content="1 000 000 ₽" Tag="1000000" Click="QuickAmount_Click"
                                Padding="10,6" Margin="3" FontSize="11" Cursor="Hand"
                                Background="#FFEDE7F6" Foreground="#FF6C2BD9" FontWeight="Bold" BorderThickness="0"/>
                        <Button Content="5 000 000 ₽" Tag="5000000" Click="QuickAmount_Click"
                                Padding="10,6" Margin="3" FontSize="11" Cursor="Hand"
                                Background="#FFEDE7F6" Foreground="#FF6C2BD9" FontWeight="Bold" BorderThickness="0"/>
                    </WrapPanel>

                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFD32F2F"
                               FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <Button Content="ПОПОЛНИТЬ" Click="TopUp_Click"
                            FontSize="16" FontWeight="Bold" Foreground="White"
                            Padding="20,12" Cursor="Hand" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF388E3C" Offset="0"/>
                                            <GradientStop Color="#FF4CAF50" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#AA388E3C" ShadowDepth="0" BlurRadius="12" Opacity="0.4"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#CC4CAF50" ShadowDepth="0" BlurRadius="25" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
